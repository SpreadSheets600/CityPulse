# Boolean Values : true | false | 1 | 0 | yes | no

# Core Utilities
SECRET_KEY=SuperDuperSecretKey
JWT_SECRET_KEY=AnotherSuperDuperSecretKey

DATABASE_URL=postgresql://postgres:password@localhost:5432/citypulse
CORS_ORIGINS=http://localhost:5173

# Feature Toggles - For Testing And Developments
S3_ENABLED=true

SMS_ENABLED=false
EMAIL_ENABLED=false
OAUTH_ENABLED=false

AI_TEXT_ENABLED=true
GEOCODING_ENABLED=true
IMAGE_CLASSIFICATION_ENABLED=true

# S3 Storage Configurations
S3_ENDPOINT_URL=https://your-s3-endpoint.example.com
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_ACCESS_KEY_ID=your_access_key_id

S3_BUCKET_NAME=your_bucket_name
S3_REGION_NAME=your_region_name

# Flask Mail Server
MAIL_SERVER=smtp.gmail.com
MAIL_USE_TLS=true
MAIL_PORT=587

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

MAIL_DEFAULT_SENDER=noreply@citypulse.com

# OAuth Services ( Google / GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/oauth/callback

FRONTEND_URL=http://localhost:5173

# SMS Service ( Twilio )
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=

# Ollama ( Local LLM )
# Inside Docker: http://ollama:11434
# Outside Docker: http://localhost:11434

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Ollama Vision Model ( Image Classification )
# Uses gemma4:31b-cloud for image understanding via Ollama
# Pull the model first: docker compose exec ollama ollama pull gemma4:31b-cloud
OLLAMA_VISION_MODEL=gemma4:31b-cloud
OLLAMA_VISION_CONFIDENCE=0.3
